rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'phamthemy3008@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'dailyGoal', 'streak', 'lastStudyDate', 'totalCardsLearned', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('dailyGoal' in data) || data.dailyGoal is int) &&
             (!('streak' in data) || data.streak is int) &&
             (!('totalCardsLearned' in data) || data.totalCardsLearned is int);
    }

    function isValidDeck(data) {
      return data.keys().hasAll(['id', 'userId', 'title']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'description', 'color', 'cardCount', 'isPublic', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 128 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 512)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 32)) &&
             (!('cardCount' in data) || data.cardCount is int) &&
             (!('isPublic' in data) || data.isPublic is bool);
    }

    function isValidCard(data) {
      return data.keys().hasAll(['id', 'deckId', 'userId', 'hanzi', 'meaning']) &&
             data.keys().hasOnly(['id', 'deckId', 'userId', 'hanzi', 'pinyin', 'meaning', 'exampleSentence', 'examplePinyin', 'exampleMeaning', 'tags', 'isWeak', 'mistakeCount', 'interval', 'repetitions', 'easeFactor', 'dueDate', 'lastReviewed', 'status', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.deckId is string && data.deckId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.hanzi is string && data.hanzi.size() > 0 && data.hanzi.size() <= 64 &&
             data.meaning is string && data.meaning.size() > 0 && data.meaning.size() <= 512 &&
             (!('pinyin' in data) || (data.pinyin is string && data.pinyin.size() <= 128)) &&
             (!('exampleSentence' in data) || (data.exampleSentence is string && data.exampleSentence.size() <= 512)) &&
             (!('examplePinyin' in data) || (data.examplePinyin is string && data.examplePinyin.size() <= 512)) &&
             (!('exampleMeaning' in data) || (data.exampleMeaning is string && data.exampleMeaning.size() <= 512)) &&
             (!('tags' in data) || data.tags is list) &&
             (!('isWeak' in data) || data.isWeak is bool) &&
             (!('mistakeCount' in data) || data.mistakeCount is int) &&
             (!('interval' in data) || data.interval is int) &&
             (!('repetitions' in data) || data.repetitions is int) &&
             (!('easeFactor' in data) || (data.easeFactor is number && data.easeFactor >= 1.0 && data.easeFactor <= 5.0)) &&
             (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 64)) &&
             (!('status' in data) || (data.status in ['new', 'learning', 'review', 'mastered']));
    }

    function isValidStudyLog(data) {
      return data.keys().hasAll(['id', 'userId', 'cardId', 'rating', 'mode']) &&
             data.keys().hasOnly(['id', 'userId', 'cardId', 'deckId', 'rating', 'mode', 'date', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.cardId is string && data.cardId.size() <= 128 &&
             data.rating is int && data.rating >= 1 && data.rating <= 4 &&
             data.mode is string && data.mode.size() <= 64;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['id', 'message', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'email', 'category', 'message', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2048 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 128)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
             (!('status' in data) || (data.status in ['unread', 'read', 'resolved']));
    }

    function isValidBlacklist(data) {
      return data.keys().hasAll(['id', 'createdAt']) &&
             data.keys().hasOnly(['id', 'email', 'userId', 'reason', 'bannedBy', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 512)) &&
             (!('bannedBy' in data) || (data.bannedBy is string && data.bannedBy.size() <= 128));
    }

    // 2. Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming());
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /decks/{deckId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true || isAdmin());
      allow create: if isVerified() && isValidId(deckId) && isValidDeck(incoming());
      allow update: if isVerified() && isValidId(deckId) && (existing().userId == request.auth.uid || isAdmin()) && isValidDeck(incoming());
      allow delete: if isVerified() && isValidId(deckId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /cards/{cardId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(cardId) && isValidCard(incoming());
      allow update: if isVerified() && isValidId(cardId) && (existing().userId == request.auth.uid || isAdmin()) && isValidCard(incoming());
      allow delete: if isVerified() && isValidId(cardId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /study_logs/{logId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(logId) && isValidStudyLog(incoming());
      // Study logs are immutable
      allow update: if false;
      allow delete: if isVerified() && isValidId(logId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // System Vocabulary (Central shared vocabulary in Cloud Firestore managed by admin)
    match /system_vocab/{docId} {
      // Anyone can read system vocabulary
      allow get, list: if true;
      // Only admin phamthemy3008@gmail.com can create, update, or delete
      allow write: if isAdmin();
    }

    // System Configurations (Donation info, app constants - readable by all, writable only by admin)
    match /system_config/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // User Feedback (Submissions from users, read/managed by admin)
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && isValidFeedback(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Blacklist (Users banned by admin)
    match /blacklist/{banId} {
      // Anyone signed in can read to verify if they are banned
      allow get, list: if isSignedIn();
      allow write: if isAdmin() && isValidBlacklist(incoming());
      allow delete: if isAdmin();
    }
  }
}
